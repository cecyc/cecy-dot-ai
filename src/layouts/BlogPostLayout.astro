---
import Layout from './Layout.astro';
import RetroNav from '../components/RetroNav.astro';
import RetroFooter from '../components/RetroFooter.astro';
import RainbowRule from '../components/RainbowRule.astro';
import RetroTag from '../components/RetroTag.astro';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  tags?: string[];
}

const { title, description, publishDate, tags = [] } = Astro.props;

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={`${title} — cecy correa`}>
  <RetroNav currentPage="posts" />

  <div class="post-container">
    <!-- Post header window -->
    <div class="post-header">
      <div class="header-titlebar">
        <span class="header-titlebar-label">POST.MD — {title}</span>
        <div class="header-dots">
          <div class="dot dot-red" />
          <div class="dot dot-yellow" />
          <div class="dot dot-green" />
        </div>
      </div>

      <div class="header-content">
        <h1 class="post-title">{title}</h1>

        <div class="post-meta">
          <span class="meta-date">{formattedDate}</span>
          {tags.length > 0 && (
            <span class="meta-sep">·</span>
          )}
          <div class="meta-tags">
            {tags.map((tag) => (
              <RetroTag variant={
                (["purple", "cyan", "pink"][tag.length % 3]) as "purple" | "cyan" | "pink"
              }>
                {tag}
              </RetroTag>
            ))}
          </div>
        </div>

        <p class="post-description">{description}</p>
      </div>
    </div>

    <RainbowRule />

    <!-- Post body -->
    <div class="post-body-wrapper">
      <div class="post-body">
        <slot />
      </div>
    </div>

    <RainbowRule />

    <div class="post-footer">
      <a href="/posts" class="back-link">← back to all posts</a>
    </div>
  </div>

  <RetroFooter />
</Layout>

<style>
  .post-container {
    max-width: 780px;
    margin: 0 auto;
    padding: 40px 20px 20px;
  }

  /* Header window */
  .post-header {
    border: 2px solid #00e5ff;
    box-shadow: 0 0 18px #00e5ff40, 0 4px 40px rgba(0, 0, 0, 0.6);
    background: rgba(14, 3, 36, 0.94);
    backdrop-filter: blur(6px);
    margin-bottom: 0;
  }

  .header-titlebar {
    background: linear-gradient(90deg, #003d4d, #00e5ff);
    padding: 5px 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #00e5ff60;
    user-select: none;
  }

  .header-titlebar-label {
    color: #fff;
    font-family: 'VT323', monospace;
    font-size: 15px;
    letter-spacing: 0.12em;
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .header-dots {
    display: flex;
    gap: 5px;
    align-items: center;
    flex-shrink: 0;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.4);
  }

  .dot-red { background: #ff6058; }
  .dot-yellow { background: #ffbd2e; }
  .dot-green { background: #28c840; }

  .header-content {
    padding: 20px 20px 16px;
  }

  .post-title {
    font-family: 'VT323', monospace;
    font-size: 40px;
    color: #00e5ff;
    line-height: 1.1;
    margin: 0 0 12px;
    text-shadow: 0 0 20px #00e5ff60;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .meta-date {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    color: #6b5a85;
    letter-spacing: 0.05em;
  }

  .meta-sep {
    color: #3d2860;
  }

  .meta-tags {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
  }

  .post-description {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    color: #9980c0;
    line-height: 1.7;
    margin: 0;
    font-style: italic;
    border-left: 2px solid #00e5ff40;
    padding-left: 12px;
  }

  /* Body wrapper */
  .post-body-wrapper {
    border: 1px solid #1c0845;
    background: rgba(14, 3, 36, 0.85);
    padding: 0;
  }

  .post-body {
    padding: 32px 36px;
    font-family: 'Space Mono', monospace;
    font-size: 13px;
    color: #c8b8e8;
    line-height: 1.85;
  }

  /* Markdown content styles */
  .post-body :global(h2) {
    font-family: 'VT323', monospace;
    font-size: 28px;
    color: #ff3fa4;
    margin: 36px 0 12px;
    padding-bottom: 6px;
    border-bottom: 1px solid #ff3fa430;
    text-shadow: 0 0 10px #ff3fa440;
  }

  .post-body :global(h3) {
    font-family: 'VT323', monospace;
    font-size: 22px;
    color: #bf5fff;
    margin: 28px 0 10px;
    text-shadow: 0 0 8px #bf5fff40;
  }

  .post-body :global(h4) {
    font-family: 'Space Mono', monospace;
    font-size: 13px;
    color: #00e5ff;
    margin: 20px 0 8px;
    letter-spacing: 0.05em;
  }

  .post-body :global(p) {
    margin: 0 0 18px;
    color: #c8b8e8;
  }

  .post-body :global(a) {
    color: #00e5ff;
    text-decoration: underline;
    transition: color 0.1s;
  }

  .post-body :global(a:hover) {
    color: #ff3fa4;
  }

  .post-body :global(strong) {
    color: #e8d8ff;
    font-weight: 700;
  }

  .post-body :global(em) {
    color: #9980c0;
    font-style: italic;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 18px 20px;
    color: #c8b8e8;
  }

  .post-body :global(li) {
    margin-bottom: 6px;
    padding-left: 4px;
  }

  .post-body :global(li)::marker {
    color: #ff3fa4;
  }

  .post-body :global(blockquote) {
    border-left: 3px solid #ffd700;
    margin: 20px 0;
    padding: 12px 16px;
    background: rgba(255, 215, 0, 0.05);
    color: #9980c0;
    font-style: italic;
  }

  .post-body :global(blockquote p) {
    margin: 0;
    color: #9980c0;
  }

  .post-body :global(code) {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    background: rgba(0, 229, 255, 0.08);
    border: 1px solid #00e5ff30;
    color: #00e5ff;
    padding: 1px 6px;
    border-radius: 2px;
  }

  .post-body :global(pre) {
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid #2a1060;
    border-left: 3px solid #bf5fff;
    padding: 20px;
    overflow-x: auto;
    margin: 0 0 20px;
    box-shadow: inset 0 2px 12px rgba(0, 0, 0, 0.4);
  }

  .post-body :global(pre code) {
    background: none;
    border: none;
    color: #e8d8ff;
    padding: 0;
    font-size: 12px;
    line-height: 1.7;
  }

  .post-body :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 24px auto;
    border: 1px solid #2a1060;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
  }

  .post-body :global(hr) {
    border: none;
    border-top: 1px dashed #2a1060;
    margin: 28px 0;
  }

  /* Footer */
  .post-footer {
    margin-top: 8px;
    text-align: left;
  }

  .back-link {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    color: #9980c0;
    text-decoration: none;
    border: 1px solid #3d1060;
    padding: 6px 16px;
    display: inline-block;
    transition: all 0.15s;
    letter-spacing: 0.05em;
  }

  .back-link:hover {
    color: #ff3fa4;
    border-color: #ff3fa4;
    box-shadow: 0 0 10px #ff3fa430;
  }

  @media (max-width: 600px) {
    .post-body {
      padding: 20px 16px;
    }

    .post-title {
      font-size: 30px;
    }
  }
</style>
