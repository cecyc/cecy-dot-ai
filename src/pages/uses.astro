---
import Layout from '../layouts/Layout.astro';
import RetroNav from '../components/RetroNav.astro';
import RetroFooter from '../components/RetroFooter.astro';
import RetroWindow from '../components/RetroWindow.astro';
import RainbowRule from '../components/RainbowRule.astro';

interface UseItem {
  name: string;
  desc: string;
  love?: boolean;
}

interface UseSection {
  title: string;
  windowTitle: string;
  accentColor: "pink" | "cyan" | "purple" | "gold";
  items: UseItem[];
}

const SECTIONS: UseSection[] = [
  {
    title: "Hardware",
    windowTitle: "HARDWARE.INI",
    accentColor: "pink",
    items: [
      {
        name: "MacMini M4 Pro",
        desc: "Can goe toe-to-toe with a MacBook Pro for almost anything, IMO.",
        love: true,
      },
      {
        name: "Logitech Lift Ergonomic Mouse",
        desc: "Don't sleep on ergonomic mice. Your hands and wrists will thank you. This one is also not too expensive and is not too bulky or ugly, as most ergonomic mice are.",
        love: true,
      },
      {
        name: "Logitech G735 Headphones",
        desc: "Very comfy, not too big, and great sound quality. Great for long coding sessions.",
      },
      {
        name: "Shure MV6 USB-C Microphone",
        desc: "Sound quality is really good for the price, and it's pretty much plug and play.",
      },
      {
        name: "YUNZII C75 Cake Meow Wireless Mechanical Keyboard",
        desc: "Cute keyboard with 3 modes and candy switches.",
      },
    ],
  },
  {
    title: "Editor & Terminal",
    windowTitle: "EDITOR.CFG",
    accentColor: "cyan",
    items: [
      {
        name: "iTerm 2",
        desc: "Have tried all the hype new terminals, and I keep coming back to iTerm. Sorry, I guess I'm not cool!",
      },
      {
        name: "Windsurf",
        desc: "Pretty much VS Code but with much better autocompletion.",
      },
      {
        name: "zsh with ohmyzsh",
        desc: "modified comfyline theme (powerline, but make it cute).",
      },
      {
        name: "opencode",
        desc: "Really the best CLI-based UX for AI code management.",
      },
      {
        name: "Victor Mono",
        desc: "Don't pay an arm and a leg for Operator Mono. Victor Mono is free and just as good.",
        love: true,
      },
    ],
  },
  {
    title: "Apps & Tools",
    windowTitle: "APPS.LST",
    accentColor: "purple",
    items: [
      {
        name: "Linear",
        desc: "Issue tracking that doesn't make me want to cry. Infinitely customizable and integrates beautifully with Slack!",
      },
      {
        name: "Notion",
        desc: "Notes, docs, project planning.",
        love: true,
      },
      {
        name: "Figma",
        desc: "The vectorize image tool is nothing short of amazing and saves me a lot of work.",
        love: true,
      },
    ],
  },
  {
    title: "Desk Setup",
    windowTitle: "DESK.TXT",
    accentColor: "gold",
    items: [
      {
        name: "UPLIFT V2 Standing Desk",
        desc: "Bamboo top, dual motors. I stand for about 2 hours a day and sit for the other 8. A work in progress.",
      },
    ],
  },
];
---

<Layout title="Uses - Cecy Correa">
  <RetroNav currentPage="uses" />

  <div style="max-width: 960px; margin: 0 auto; padding: 40px 20px 20px;">
    <!-- Header -->
    <RetroWindow
      title="USES.TXT — my setup"
      accentColor="gold"
      class="mb-6"
    >
      <div>
        <div
          style="font-family: 'VT323', monospace; font-size: 28px; color: #ffd700; margin-bottom: 6px;"
        >
          What I Use
        </div>
        <p
          style="font-family: 'Space Mono', monospace; font-size: 12px; color: #9980c0; line-height: 1.8; margin-bottom: 8px;"
        >
          A living document of the hardware, software, and services I use
          daily. Inspired by{" "}
          <a href="https://uses.tech" class="retro-link">
            uses.tech
          </a>
        </p>
        <p
          style="font-family: 'Space Mono', monospace; font-size: 11px; color: #6b5a85;"
        >
          Items marked with{" "}
          <span style="color: #ff3fa4;">♥</span> are things I
          particularly love.
        </p>
      </div>
    </RetroWindow>
    <RetroWindow title="AI.EXE — skills" accentColor="purple" class="mb-6">
      <div>
        <div
          style="font-family: 'VT323', monospace; font-size: 20px; color: #bf5fff; margin-bottom: 10px; border-bottom: 1px solid #1c0845; padding-bottom: 6px;"
        >
          AI Skills
        </div>
        <p
          style="font-family: 'Space Mono', monospace; font-size: 12px; color: #9980c0; line-height: 1.8; margin-bottom: 8px;"
        >
          My repository of AI skills for software development.{" "}
          <a href="https://github.com/cecyc/ai-skillz" class="retro-link">
            View on Github.
          </a>
        </p>
      </div>
    </RetroWindow>

    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 24px;"
    >
      {SECTIONS.map((section) => (
        <RetroWindow
          title={section.windowTitle}
          accentColor={section.accentColor}
        >
          <div>
            <div
              style={{
                fontFamily: "'VT323', monospace",
                fontSize: "20px",
                color:
                  section.accentColor === "pink"
                    ? "#ff3fa4"
                    : section.accentColor === "cyan"
                    ? "#00e5ff"
                    : section.accentColor === "purple"
                    ? "#bf5fff"
                    : "#ffd700",
                marginBottom: "10px",
                borderBottom: "1px solid #1c0845",
                paddingBottom: "6px",
              }}
            >
              {section.title}
            </div>
            {section.items.map((item) => (
              <div
                class="uses-item"
                style="padding: 10px 8px; border-bottom: 1px dashed #1c0845; transition: background 0.1s;"
              >
                <div
                  style="display: flex; align-items: baseline; gap: 8px; margin-bottom: 4px;"
                >
                  <span
                    style="font-family: 'Space Mono', monospace; font-size: 13px; color: #e8d8ff;"
                  >
                    {item.name}
                  </span>
                  {item.love && (
                    <span
                      style="font-size: 12px; color: #ff3fa4; text-shadow: 0 0 6px #ff3fa4;"
                      title="I love this"
                    >
                      ♥
                    </span>
                  )}
                </div>
                <p
                  style="font-family: 'Space Mono', monospace; font-size: 11px; color: #6b5a85; line-height: 1.6;"
                >
                  {item.desc}
                </p>
              </div>
            ))}
          </div>
        </RetroWindow>
      ))}
    </div>

    <RainbowRule />

    <div
      style="text-align: center; font-family: 'Space Mono', monospace; font-size: 11px; color: #3d2860;"
    >
      last updated: may 2024 · this page is part of the{" "}
      <a href="https://uses.tech" class="retro-link" style="font-size: 11px;">
        uses.tech
      </a>{" "}
      community ✦
    </div>
  </div>

  <RetroFooter />
</Layout>

<style>
  .mb-6 {
    margin-bottom: 24px;
  }
</style>
