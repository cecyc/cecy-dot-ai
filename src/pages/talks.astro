---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RetroNav from '../components/RetroNav.astro';
import RetroFooter from '../components/RetroFooter.astro';
import RetroWindow from '../components/RetroWindow.astro';
import RainbowRule from '../components/RainbowRule.astro';
import TalksFilter from '../components/TalksFilter';

const allTalks = await getCollection('talks');
const TALKS = allTalks.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const talksData = TALKS.map((talk) => ({
  title: talk.data.title,
  conference: talk.data.conference,
  date: talk.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short' }),
  youtubeId: talk.data.youtubeId,
  description: talk.data.description,
}));
---

<Layout title="Talks - Cecy Correa">
  <RetroNav currentPage="talks" />

  <div style="max-width: 960px; margin: 0 auto; padding: 40px 20px 20px;">
    <RetroWindow title="TALKS.EXE — public speaking" accentColor="purple" class="mb-8">
      <div>
        <div
          style="font-family: 'VT323', monospace; font-size: 28px; color: #bf5fff; margin-bottom: 8px;"
        >
          Talks & Speaking
        </div>
        <p
          style="font-family: 'Space Mono', monospace; font-size: 12px; color: #9980c0; line-height: 1.8; margin-bottom: 12px;"
        >
          These are some selected talks I have done that I'm very proud of.
        </p>
      </div>
    </RetroWindow>

    <TalksFilter talks={talksData} client:load />

    <RainbowRule />

    <div
      style="text-align: center; font-family: 'Space Mono', monospace; font-size: 11px; color: #3d2860;"
    >
      ✦ more talks coming soon ✦
    </div>
  </div>

  <RetroFooter />
</Layout>

<style>
  .mb-8 {
    margin-bottom: 32px;
  }
</style>
