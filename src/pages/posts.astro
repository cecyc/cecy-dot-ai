---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RetroNav from '../components/RetroNav.astro';
import RetroWindow from '../components/RetroWindow.astro';
import RetroFooter from '../components/RetroFooter.astro';
import PostsFilter from '../components/PostsFilter.tsx';

const allPosts = await getCollection('blog');
const posts = allPosts
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .map((post) => ({
    title: post.data.title,
    date: post.data.publishDate.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    }),
    slug: post.id,
    tags: post.data.tags ?? [],
    excerpt: post.data.description,
  }));
---

<Layout title="Posts - Cecy">
  <RetroNav currentPage="posts" />

  <div style="max-width: 960px; margin: 0 auto; padding: 40px 20px 20px;">
    <!-- Header -->
    <RetroWindow
      title="POSTS.DIR — blog & writing"
      accentColor="cyan"
      class="header-window"
    >
      <div>
        <div
          style="font-family: 'VT323', monospace; font-size: 28px; color: #00e5ff; margin-bottom: 6px;"
        >
          Writing
        </div>
        <p
          style="font-family: 'Space Mono', monospace; font-size: 12px; color: #9980c0; line-height: 1.7;"
        >
          Sometimes I have thoughts. It happens rarely, but I post them here when it does.
        </p>
      </div>
    </RetroWindow>

    <!-- Interactive Filter Component (React Island) -->
    <PostsFilter posts={posts} client:load />
  </div>

  <RetroFooter />
</Layout>

<style>
  .header-window {
    margin-bottom: 24px;
  }
</style>
